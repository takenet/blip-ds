{
  "name": "blip-ds",
  "version": "2.0.0-rc",
  "description": "Blip Design System",
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.16.0": true
  },
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "es2015": "./dist/esm/index.mjs",
  "es2017": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "collection": "./dist/collection/collection-manifest.json",
  "collection:main": "./dist/collection/index.js",
  "unpkg": "./dist/blip-ds/blip-ds.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "generate": "stencil generate",
    "clear": "rimraf dist/ && rimraf www/ && rimraf .stencil && rimraf screenshot && rimraf loader && rimraf coverage && rimraf storybook-static && rimraf blip-ds-react/node_modules && rimraf node_modules/",
    "dev": "stencil build --docs && concurrently \"npm:build:watch\" \"npm:storybook\"",
    "start": "stencil build --dev --watch --serve --docs",
    "build": "npm run assets:prepare && stencil build --docs --prod && npm run assets:strip && npm run assets:check",
    "assets:prepare": "node scripts/prepare_assets.cjs",
    "assets:verify": "node scripts/prepare_assets.cjs --verify",
    "assets:check": "node scripts/check_asset_bundle.cjs",
    "assets:strip": "node scripts/check_asset_bundle.cjs --strip-copied",
    "docs:check-uai": "node scripts/check_uai_jsdoc.cjs",
    "lint:uai-tokens": "node scripts/check_uai_tokens.cjs",
    "assets:update-tokens": "npm install --package-lock-only --save-exact --ignore-scripts --legacy-peer-deps blip-tokens@latest",
    "prestart": "npm run assets:prepare",
    "predev": "npm run assets:prepare",
    "prebuild:watch": "npm run assets:prepare",
    "pretest": "npm run assets:prepare",
    "pretest:unit": "npm run assets:prepare",
    "pretest:e2e": "npm run assets:prepare",
    "pretest:watch": "npm run assets:prepare",
    "build:watch": "stencil build --watch",
    "build:react": "npm ci --prefix blip-ds-react --ignore-scripts --strict-peer-deps && npm run build --prefix blip-ds-react",
    "test": "stencil test --spec --e2e --screenshot --coverage --runInBand",
    "test:e2e": "stencil test --e2e --screenshot --runInBand",
    "test:unit": "stencil test --spec --coverage",
    "test:watch": "stencil test --spec --e2e --screenshot --watch",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:playwright": "npx playwright test",
    "test:playwright:visual": "npx playwright test tests/playwright/visual/",
    "test:playwright:functional": "npx playwright test tests/playwright/functional/",
    "test:playwright:update": "npx playwright test --update-snapshots",
    "test:playwright:report": "npx playwright show-report",
    "eslint": "eslint . --ext .jsx,.ts,.tsx --fix",
    "semantic-release": "semantic-release",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@playwright/test": "^1.64.1",
    "@stencil/core": "^4.45.2",
    "@stencil/react-output-target": "^1.6.5",
    "@stencil/sass": "^3.3.3",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/react-webpack5": "^10.6.5",
    "@types/aria-query": "^5.0.4",
    "@types/color": "^4.2.1",
    "@types/conventional-commits-parser": "^5.0.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack": "^5.28.5",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "babel-loader": "^10.1.1",
    "color": "^5.0.3",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.5",
    "husky": "^9.1.7",
    "ignore-loader": "^0.1.2",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.5",
    "ts-node": "^10.9.2",
    "types-ramda": "^0.32.0",
    "typescript": "~6.0.3",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "blip-tokens": "2.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/takenet/blip-ds.git"
  },
  "bugs": {
    "url": "https://github.com/takenet/blip-ds/issues"
  },
  "homepage": "https://github.com/takenet/blip-ds#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "license": "MIT",
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "^12.2.1"
    },
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "^7.4.6"
    },
    "tmp": "^0.2.7",
    "babel-jest": {
      "@babel/core": "^7.29.7"
    },
    "babel-preset-jest": {
      "@babel/core": "^7.29.7"
    },
    "babel-preset-current-node-syntax": {
      "@babel/core": "^7.29.7"
    },
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/typescript-estree": "^8.18.1",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "typescript": "~6.0.3",
    "nth-check": "^2.1.1",
    "postcss": "^8.5.5",
    "svgo": "^3.3.2",
    "rimraf": "^6.1.3"
  },
  "exports": {
    ".": {
      "import": "./dist/blip-ds/blip-ds.esm.js",
      "require": "./dist/blip-ds/blip-ds.js"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./dist/components": {
      "types": "./dist/types/components.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    }
  },
  "release": {
    "tagFormat": "blip-ds@v${version}",
    "branches": [
      "master",
      "main",
      {
        "name": "v2",
        "prerelease": "rc",
        "channel": "rc"
      }
    ]
  }
}
