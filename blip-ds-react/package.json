{
  "name": "blip-ds-react",
  "sideEffects": false,
  "packageManager": "npm@12.2.1",
  "version": "0.0.0-development",
  "private": false,
  "description": "React specific wrapper for blip-ds",
  "repository": {
    "type": "git",
    "url": "https://github.com/takenet/blip-ds.git"
  },
  "scripts": {
    "build": "npm run tsc",
    "tsc": "tsc -p . --outDir ./dist",
    "rollup": "rollup -c"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@stencil/react-output-target": "^1.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "blip-ds": "file:../",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "^12.2.1"
    }
  },
  "release": {
    "tagFormat": "blip-ds-react@v${version}",
    "branches": [
      "master",
      "main",
      {
        "name": "v2",
        "prerelease": "rc",
        "channel": "rc"
      }
    ]
  }
}